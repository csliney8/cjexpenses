# ── Database ──────────────────────────────────────────────────────────────────
# For local dev, Docker Compose sets this automatically.
# For EC2, set to your RDS endpoint:
DATABASE_URL=postgresql://postgres:yourpassword@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/expensedb

# ── Flask ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string

# ── AWS ────────────────────────────────────────────────────────────────────────
# On EC2, prefer using an IAM Role (attach AmazonS3FullAccess + AmazonTextractFullAccess)
# so that you do NOT need to set these keys. Leave blank if using IAM role.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── S3 ─────────────────────────────────────────────────────────────────────────
# Your S3 bucket name (receipts will be uploaded here)
S3_BUCKET=your-expense-tracker-receipts
